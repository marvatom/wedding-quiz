---
pagination:
  data: questions.questions
  size: 1
  alias: question
permalink: "q/{{ question.id | questionHash }}/"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wedding Quiz</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #faf8f5;
      color: #222;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    main { max-width: 480px; width: 100%; }
    .card {
      background: #fff;
      border-radius: 12px;
      padding: 2rem 1.5rem;
      box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }
    .label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #888;
      margin-bottom: 1rem;
    }
    h1 {
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1.4;
      margin-bottom: 1.5rem;
    }
    .choices { display: flex; flex-direction: column; gap: 0.75rem; }
    .choice {
      display: block;
      padding: 0.875rem 1rem;
      border: 2px solid #e0dbd4;
      border-radius: 8px;
      cursor: pointer;
      font-size: 1rem;
      background: #fff;
      text-align: left;
      width: 100%;
      transition: border-color 0.15s;
    }
    .choice:hover:not(:disabled) { border-color: #b0a89e; }
    .choice.selected { border-color: #555; background: #f5f3f0; }
    .submit {
      margin-top: 1.25rem;
      width: 100%;
      padding: 0.875rem;
      background: #222;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
    }
    .submit:disabled { opacity: 0.4; cursor: not-allowed; }
    .feedback { margin-top: 1.25rem; padding: 1rem; border-radius: 8px; font-weight: 600; }
    .feedback.correct { background: #e8f5e9; color: #2e7d32; }
    .feedback.wrong { background: #fce4ec; color: #b71c1c; }
    .feedback .detail { font-weight: 400; margin-top: 0.5rem; }
  </style>
</head>
<body>
  <main>
    <div class="card">
      <div class="label">Svatební kvíz - otázka {{ pagination.pageNumber + 1 }} z {{ pagination.pages.length }}</div>
      <h1 id="stem"></h1>
      <div class="choices" id="choices"></div>
      <button class="submit" id="submit" disabled>Je to tak?</button>
      <div class="feedback" id="feedback" hidden></div>
    </div>
  </main>
  <script>
    var Q = {{ question | dump | safe }};
    var multiCorrect = Q.choices.filter(function (c) { return c.correct; }).length > 1;
    var selected = multiCorrect ? [] : null;

    document.getElementById('stem').textContent = Q.stem;

    if (multiCorrect) {
      var hint = document.createElement('p');
      hint.style.cssText = 'font-size:0.85rem;color:#888;margin-bottom:0.75rem;';
      hint.textContent = 'Vyber všechny správné odpovědi.';
      document.getElementById('choices').before(hint);
    }

    var choicesEl = document.getElementById('choices');
    Q.choices.forEach(function (c, i) {
      var btn = document.createElement('button');
      btn.className = 'choice';
      btn.textContent = c.text;
      btn.setAttribute('data-index', i);
      btn.addEventListener('click', function () {
        if (multiCorrect) {
          var idx = selected.indexOf(i);
          if (idx === -1) {
            selected.push(i);
            btn.classList.add('selected');
          } else {
            selected.splice(idx, 1);
            btn.classList.remove('selected');
          }
          document.getElementById('submit').disabled = selected.length === 0;
        } else {
          document.querySelectorAll('.choice').forEach(function (b) {
            b.classList.remove('selected');
          });
          btn.classList.add('selected');
          selected = i;
          document.getElementById('submit').disabled = false;
        }
      });
      choicesEl.appendChild(btn);
    });

    document.getElementById('submit').addEventListener('click', function () {
      var fb = document.getElementById('feedback');
      document.getElementById('submit').disabled = true;
      document.querySelectorAll('.choice').forEach(function (b) {
        b.disabled = true;
      });
      fb.hidden = false;

      var isCorrect;
      if (multiCorrect) {
        var correctIndices = Q.choices.reduce(function (acc, c, i) {
          if (c.correct) acc.push(i);
          return acc;
        }, []);
        isCorrect = selected.length === correctIndices.length &&
          correctIndices.every(function (i) { return selected.indexOf(i) !== -1; });
      } else {
        isCorrect = selected !== null && Q.choices[selected].correct;
      }

      if (isCorrect) {
        fb.className = 'feedback correct';
        fb.textContent = 'Správně!';
      } else {
        fb.className = 'feedback wrong';
        fb.textContent = 'Bohužel ne. Zkus to znovu.';

        selected = multiCorrect ? [] : null;
        document.querySelectorAll('.choice').forEach(function (b) {
          b.disabled = false;
          b.classList.remove('selected');
        });
        document.getElementById('submit').disabled = true;
      }
    });
  </script>
</body>
</html>
